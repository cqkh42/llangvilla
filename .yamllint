---
extends: default
rules:
  line-length:
    max: 140
  document-start: disable
  truthy:
    check-keys: false   # GitHub Actions' `on:`
  # What ansible-lint requires of a custom config (it warns otherwise):
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
