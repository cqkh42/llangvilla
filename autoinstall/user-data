#cloud-config
autoinstall:
  version: 1
  locale: en_GB.UTF-8
  keyboard:
    layout: gb
  timezone: Europe/London

  source:
    id: ubuntu-desktop-minimal

  network:
    version: 2
    renderer: NetworkManager
    ethernets:
      any-ethernet:
        match:
          name: "en*"
        dhcp4: true
        optional: true
    wifis:
      all-wifis:
        match:
          name: "wl*"
        dhcp4: true
        optional: true
        access-points:
          "__WIFI_SSID__":
            password: "__WIFI_PASSWORD__"

  storage:
    layout:
      name: direct

  identity:
    realname: Jack Cooper-McEwan
    username: jack
    hostname: optiplex
    # Generate with: mkpasswd -m sha-512   (or: openssl passwd -6)
    # This is the login password for the desktop, sudo and SSH.
    password: "__PASSWORD_HASH__"

  ssh:
    install-server: true
    allow-pw: true
    # Optional: add keys, then set allow-pw: false
    # authorized-keys:
    #   - ssh-ed25519 AAAA... jack@laptop

  # Ubuntu Pro: token from https://ubuntu.com/pro/dashboard (starts with C).
  # Fill in on the USB copy only. Delete this section to skip Pro.
  ubuntu-pro:
    token: "__UBUNTU_PRO_TOKEN__"

  codecs:
    install: true
  drivers:
    install: false

  packages:
    - ansible
    - git

  late-commands:
    - |
      cat > /target/etc/systemd/system/ansible-pull-firstboot.service <<'EOF'
      [Unit]
      Description=Initial ansible-pull
      After=network-online.target
      Wants=network-online.target
      ConditionPathExists=!/var/lib/ansible-pull-firstboot.done

      [Service]
      Type=oneshot
      ExecStart=/usr/bin/ansible-pull -U https://github.com/cqkh42/llangvilla.git ansible/site.yml
      ExecStartPost=/usr/bin/touch /var/lib/ansible-pull-firstboot.done
      Restart=on-failure
      RestartSec=60

      [Install]
      WantedBy=multi-user.target
      EOF
    - curtin in-target --target=/target -- systemctl enable ansible-pull-firstboot.service
