autoinstall:
  version: 1
  locale: en_GB.UTF-8
  keyboard:
    layout: gb
  source:
    id: ubuntu-desktop-minimal
  network:
    version: 2
    wifis:
      all-wifis:
        match:
          name: "wl*"
        dhcp4: true
        access-points:
          "__WIFI_SSID__":
            password: "__WIFI_PASSWORD__"
  storage:
    layout:
      name: direct
  identity:
    realname: Jack Cooper-McEwan
    username: jack
    hostname: optiplex
    # Generate with: mkpasswd -m sha-512
    password: " "
  ssh:
    install-server: true
    allow-pw: true
  codecs:
    install: true
  drivers:
    install: false
  packages:
    - ansible
    - git
  timezone: Europe/London
