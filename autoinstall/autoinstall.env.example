# autoinstall.env - read by install.sh from the stick's arch-autoinstall/ folder.
# build-usb.sh copies this template onto the stick (only if none is there yet).
# Replace every double-underscore placeholder ON THE STICK. Never commit a filled-in copy.
# Values are sourced by bash: use SINGLE quotes.
# Check a filled-in copy from the build computer with:
#   autoinstall/install.sh --check /path/to/autoinstall.env

# ---------------------------------------------------------------- network
# Wi-Fi used (a) by the live installer if there is no cable, and
# (b) configured on the installed system. Set both to '' for cable only.
WIFI_SSID='__WIFI_SSID__'
WIFI_PSK='__WIFI_PASSWORD__'
WIFI_HIDDEN=0

# ---------------------------------------------------------------- disk
# auto = largest internal (non-USB) disk of at least 40 GB. Pinning the disk is safer:
#   TARGET_DISK=/dev/disk/by-id/nvme-Samsung_SSD_980_1TB_XXXXXXXX
# (find it on the machine with: ls -l /dev/disk/by-id/)
TARGET_DISK=auto

# A BLANK target disk is erased after this countdown (any key aborts). 0 = no wait.
CONFIRM_SECONDS=30

# A target disk that already holds partitions or a filesystem (for example a
# previous install, if the stick is left in) is never erased on a countdown:
#   ask  = wait until someone types YES at the console (default)
#   wipe = treat it like a blank disk. Dangerous: a forgotten stick reinstalls the machine.
NONBLANK_DISK=ask

# Root filesystem: btrfs (subvolumes, snapshots) or ext4
ROOT_FS=btrfs

# ---------------------------------------------------------------- system
HOST_NAME='optiplex'
TIMEZONE='Europe/London'
LOCALE='en_GB.UTF-8'
KEYMAP='uk'          # console keymap
X11_KEYMAP='gb'      # keyboard layout for SDDM / Plasma
KERNELS='linux linux-lts'    # the first is the default boot entry
EXTRA_PACKAGES=''            # space-separated, on top of packages.txt

# ---------------------------------------------------------------- user
USER_NAME='jack'
REAL_NAME='Jack Cooper-McEwan'
# Password hash, made on any Linux machine with:  openssl passwd -6
# (paste the whole $6$... string, in single quotes)
PASSWORD_HASH='__PASSWORD_HASH__'

# 1 = lock the root account (log in as USER_NAME and use sudo).
LOCK_ROOT=1

# ---------------------------------------------------------------- SSH
# 1 = enable the SSH server on the installed system.
ENABLE_SSH=1
# Public keys for USER_NAME: fetched from this URL at install time, plus any listed
# literally in SSH_AUTHORIZED_KEYS (one per line). Public keys are not secret.
SSH_KEYS_URL='https://github.com/cqkh42.keys'
SSH_AUTHORIZED_KEYS=''
# 0 = key-only login. If no key could be installed, password login stays on
# (with a warning) so you are never locked out.
SSH_PASSWORD_AUTH=0

# ---------------------------------------------------------------- first boot
# First-boot ansible-pull. Empty ANSIBLE_PULL_URL = skip.
ANSIBLE_PULL_URL='https://github.com/cqkh42/llangvilla.git'
ANSIBLE_PULL_BRANCH=''       # empty = the repo's default branch
ANSIBLE_PLAYBOOK='ansible/site.yml'

# 1 = run ansible-pull to completion BEFORE the login screen appears.
# 0 = run it in the background after the login screen is up (retries every 60 s).
ANSIBLE_BEFORE_LOGIN=1

# 1 = reboot once automatically after a successful ansible-pull. Never loops.
ANSIBLE_REBOOT_AFTER=1

# ---------------------------------------------------------------- installer behaviour
# What to do when the install fails: shell = stop at a root shell on the console,
# poweroff = save the logs to the stick and power off (test-vm.sh uses this).
ON_FAILURE=shell
