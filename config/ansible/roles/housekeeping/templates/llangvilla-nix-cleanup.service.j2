# Written by config/ansible (housekeeping role). Edit the role, not this file.
[Unit]
Description=Remove old home-manager generations and unused Nix store paths
After=nix-daemon.socket

[Service]
Type=oneshot
# 1. The user's home-manager generations older than {{ housekeeping_nix_keep }} (the
#    current one is always kept). They live in the user's home, where a root-only
#    cleanup doesn't reach. Skipped until home-manager has made a first generation.
#    ($$ is a literal $: systemd expands $VAR itself, even inside quotes.)
ExecStart=/usr/bin/runuser -u {{ user_name }} -- /usr/bin/env HOME={{ user_home }} NIX_REMOTE=daemon /bin/sh -c 'p="$$HOME/.local/state/nix/profiles/home-manager"; [ -e "$$p" ] || exit 0; exec /usr/bin/nix-env --profile "$$p" --delete-generations {{ housekeeping_nix_keep }}'
# 2. Everything in the store that nothing uses any more.
ExecStart=/usr/bin/nix-collect-garbage
